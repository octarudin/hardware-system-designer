# Local-only defaults. Replace every credential in deployed environments.
NODE_ENV=development
LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1

POSTGRES_DB=hardware_system_designer
POSTGRES_USER=hwsd
POSTGRES_PASSWORD=hwsd_local_only
DATABASE_URL=postgresql://hwsd:hwsd_local_only@127.0.0.1:5432/hardware_system_designer

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=hwsd-datasheets
S3_ACCESS_KEY=hwsd_local
S3_SECRET_KEY=hwsd_local_only
S3_FORCE_PATH_STYLE=true
